{
  "name": "@zynactra/payload-admin-theme",
  "version": "0.1.0",
  "description": "Zynactra's admin theme for Payload CMS, customizable per client",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/theme.css dist/ && cp -R src/fonts dist/fonts",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "payload": "^3.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "payload": "3.93.0",
    "react": "19.2.6",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.34.5"
}
